etails": [{"method": "bank_transfer", "label": "Bank transfer — Meezan Bank", "lines": ["Title: Makkah Hostels", "Account: 0101-0123456789", "IBAN: PK36MEZN0001010123456789"]}, {"method": "jazzcash", "label": "JazzCash", "lines": ["Number: 0300-1112223", "Name: M. Ali"]}, {"method": "easypaisa", "label": "Easypaisa", "lines": ["Number: 0345-4445556", "Name: M. Ali"]}], "payment_instructions": "Send screenshot to 0300-1112223.", "rules_text": {"Conduct and activities": ["Residents must not organise, join or promote any political, religious, sectarian or unlawful activity, meeting, rally or fundraising inside the hostel.", "Posters, banners, flags, wall-chalking and distributing pamphlets are not allowed anywhere on the premises.", "Smoking, vaping, sheesha, alcohol, drugs and gambling are strictly prohibited.", "Weapons of any kind, fireworks and flammable or hazardous materials are not allowed.", "Fighting, ragging, harassment, bullying, abusive language or threatening behaviour will lead to immediate cancellation of admission.", "Residents must respect the privacy, belongings and religious practices of other residents."], "Guests and visitors": ["Guests are not allowed to stay overnight in the hostel under any circumstances.", "Visitors may meet residents only in the visitors’ area, between 4-7. Visitors are not allowed inside rooms.", "Every visitor must show a CNIC at the front desk and be entered in the visitors’ register.", "Residents are responsible for the conduct of their visitors."], "Timings and leave": ["The main gate closes at 10:00 PM. Late entry is allowed only with prior permission from the hostel office.", "Residents must inform the office before staying away overnight and record their leave in the register. Parents may be informed.", "Quiet hours are 11-7. Loud music, calls and gatherings are not allowed during this time."], "Rooms and property": ["Rooms and beds are allotted by the management. Changing rooms, sharing a bed or subletting is not allowed.", "Cooking and high-power appliances (heaters, stoves, induction plates) are not allowed in rooms.", "Any damage to hostel property will be repaired or replaced at the resident’s cost.", "Rooms must be kept clean. Pets are not allowed.", "The management may inspect any room at any time, in the presence of the resident where possible.", "Lights, fans and AC must be switched off when leaving the room.", "The hostel is not responsible for the loss of cash, jewellery, phones or other valuables."], "Fees and leaving": ["Rent is payable in advance by the 10th of every month; after that a late fee may be charged.", "Rent paid for a month is not refundable, even if the resident leaves early.", "Residents must give 30 days’ written notice before leaving. Without notice, one month’s rent may be deducted from the security deposit.", "The security deposit is returned at the time of leaving, after all dues and damages are cleared and the room is handed over."], "Documents and safety": ["Copies of CNIC, recent photographs and police verification must be submitted, and any change of phone number or address reported to the office.", "Residents must report illness, injury or any emergency to the office immediately and follow fire and safety instructions.", "The management may cancel admission for breaking any rule. The management’s decision is final.", "These rules may be updated from time to time; residents will be informed and must follow the updated rules."]}, "can_edit": true}, "app_latest": {"ok": true, "available": false}, "electricity": {"ok": true, "bills": [{"id": 2, "bill_no": "EB-202607-M2-002", "month": "2026-07", "meter_id": 2, "meter_label": "Second floor", "meter_no": "LESCO-22", "meter_type": "electricity", "unit_label": "units", "reading_date": "2026-07-31", "prev_reading": 0.0, "curr_reading": 50.0, "units": 50.0, "rate": 62.0, "extra_charges": 0.0, "extra_label": null, "meter_total": 3100.0, "billed_total": 3100.0, "beds": 1, "due_date": null, "notes": null, 